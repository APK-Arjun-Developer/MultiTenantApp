{
  "name": "multitenantclient",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "E2E_COVERAGE=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "check": "bun run format && bun run lint --fix && bun run typecheck && bun run test:coverage && bun run build && bun run test:e2e:coverage",
    "release": "semantic-release"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-table": "^8.21.3",
    "async-mutex": "^0.5.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "framer-motion": "^12.42.2",
    "mui-schema-form-builder": "^1.10.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "monocart-coverage-reports": "^3.2.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.34",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.5",
    "follow-redirects": "^1.16.2",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.6"
  }
}
